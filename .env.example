# ---- Generation provider (the model that writes answers) ----
# One of: gemini | ollama | openai | anthropic
CHAT_PROVIDER=gemini

# Gemini free tier: https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Used only when CHAT_PROVIDER=ollama (fully offline mode)
OLLAMA_CHAT_MODEL=qwen3:4b

# Optional alternatives
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Embeddings (always local by default) ----
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=6
MIN_SCORE=0.35

PORT=3001
